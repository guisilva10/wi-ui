{
  "name": "@wi-ui/cli",
  "version": "0.1.0",
  "description": "CLI para adicionar componentes WI.UI ao seu projeto",
  "type": "module",
  "bin": {
    "wi-ui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
